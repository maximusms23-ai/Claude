  "v41_fixes": [
    {
      "id": "F1",
      "herkunft": "gemeldet",
      "bereich": "GRUB-Syntaxpruefung",
      "befund": "bash -n war fuer grub.cfg zustaendig gemacht. Gemessen: Fehlalarm bei gueltiger Datei (rc=2), kein Alarm bei nicht geschlossener menuentry-Klammer (rc=0).",
      "korrektur": "mt2_grub_check_cfg nutzt grub-script-check. install.sh bricht ohne das Programm mit Code 6 ab.",
      "tests": "R1.1-R1.8"
    },
    {
      "id": "F2",
      "herkunft": "gemeldet",
      "bereich": "Offline-Installation",
      "befund": "Nur apt-get update war auf die lokale Quelle ausgerichtet. Simulation und Installation liefen gegen die Systemquellen.",
      "korrektur": "Gepinnte Paketverwaltung mit sourcelist, sourceparts=/dev/null und eigener Listenablage. Jeder Aufruf laeuft ueber mt2_apt. Dreistufige Pruefung in mt2_apt_pin_verify.",
      "tests": "R2.1-R2.11"
    },
    {
      "id": "F3",
      "herkunft": "gemeldet",
      "bereich": "Rueckfall",
      "befund": "apt-get autoremove war unbegrenzt. Die Entfernungsliste entstand aus Namensmustern. Die Sicherung wurde ungeprueft zurueckgeschrieben.",
      "korrektur": "Kein autoremove. Aufzeichnung jeder Datei- und Paketaenderung. Siegelpruefung der Sicherung mit Abbruch bei Abweichung.",
      "tests": "R5.1-R5.9, R6.1-R6.9"
    },
    {
      "id": "F4",
      "herkunft": "gemeldet",
      "bereich": "Pruefsummen",
      "befund": "Eine abweichende Pruefsummenliste wurde selbsttaetig ueberschrieben.",
      "korrektur": "Abbruch mit Code 13. Uebernahme nur mit --accept-new-checksums und Herkunftsvermerk.",
      "tests": "R4.1-R4.7"
    },
    {
      "id": "F5",
      "herkunft": "gemeldet",
      "bereich": "exFAT",
      "befund": "Es gab nur eine Warnung. Die Startbarkeit am Ziel wurde nicht geprueft.",
      "korrektur": "Dateisystembewertung, Pruefung der Startbarkeit nach der Uebertragung, START-HIER.txt, Verknuepfungspruefung, alle Anleitungen mit bash.",
      "tests": "R8.1-R8.11"
    },
    {
      "id": "F6",
      "herkunft": "selbst gefunden",
      "bereich": "Pfade mit Sonderzeichen",
      "befund": "Ein Leerzeichen im Paketpfad zerlegte die apt-Quelle. udisks2 haengt Wechselmedien unter /media/<benutzer>/<bezeichnung> ein.",
      "korrektur": "mt2_url_encode_path kodiert Leerzeichen, Prozent, Raute, Fragezeichen und eckige Klammern.",
      "tests": "R3.1-R3.5"
    },
    {
      "id": "F7",
      "herkunft": "selbst gefunden",
      "bereich": "apt-Sandkasten",
      "befund": "apt laesst die Rechte auf _apt fallen. Auf einem Wechseldatentraeger mit Modus 0700 bricht apt-get update mit Rueckgabe 100 ab.",
      "korrektur": "Lesbarkeitsprobe mit runuser oder setpriv. Bei Bedarf APT::Sandbox::User root mit Begruendung im Protokoll.",
      "tests": "R11.6"
    },
    {
      "id": "F8",
      "herkunft": "Code-Review der eigenen Korrekturen",
      "bereich": "set -e",
