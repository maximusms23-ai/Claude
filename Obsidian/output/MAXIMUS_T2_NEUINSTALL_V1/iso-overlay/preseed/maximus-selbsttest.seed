# MAXIMUS T2 Neuinstallation V1 - Preseed fuer den Selbsttest
#
# Diese Datei ist mit maximus-de.seed inhaltsgleich.
# Sie dient nur dem Nachweis, dass der Installer eine Preseed laedt.
# Der Eintrag im Startmenue installiert nichts.
#
# Nachgewiesen in /scripts/casper-bottom/24preseed des mitgelieferten Initramfs.

# --- Sprache, Tastatur, Zeitzone -----------------------------------------
d-i debian-installer/locale string de_DE.UTF-8
d-i localechooser/supported-locales multiselect de_DE.UTF-8, en_US.UTF-8
d-i keyboard-configuration/xkb-keymap select de
d-i keyboard-configuration/layoutcode string de
d-i keyboard-configuration/modelcode string pc105
d-i keyboard-configuration/variantcode string
d-i console-setup/ask_detect boolean false
d-i time/zone string Europe/Berlin
d-i clock-setup/utc boolean true
d-i clock-setup/ntp boolean false

# --- Netz: die Grundinstallation laeuft offline ---------------------------
# Ohne diese Zeilen fragt der Installer nach einem Netzwerk.
d-i netcfg/choose_interface select auto
d-i netcfg/dhcp_timeout string 10
d-i netcfg/dhcpv6_timeout string 10
d-i netcfg/link_detection_timeout string 5
d-i netcfg/get_hostname string macbook-t2
d-i netcfg/get_domain string
d-i netcfg/hostname string macbook-t2
# Keine Spiegelserver-Abfrage. Es wird nichts aus dem Netz geladen.
d-i apt-setup/use_mirror boolean false
d-i apt-setup/restricted boolean false
d-i apt-setup/universe boolean false
d-i apt-setup/multiverse boolean false
d-i apt-setup/services-select multiselect
d-i apt-setup/proposed boolean false
d-i apt-setup/backports boolean false
d-i pkgsel/update-policy select none
d-i pkgsel/upgrade select none
d-i pkgsel/install-language-support boolean false
ubiquity ubiquity/download_updates boolean false
ubiquity ubiquity/use_nonfree boolean false
ubiquity ubiquity/install_oem boolean false
ubiquity ubiquity/minimal_install boolean false

# --- Kernelparameter fuer T2-Macs ----------------------------------------
# Diese Parameter stammen aus dem Projekt t2linux und aus der Fassung V4.2.
d-i debian-installer/add-kernel-opts string pm_async=off intel_iommu=on iommu=pt pcie_ports=native

# --- Keine Routinefragen nach der Freigabe -------------------------------
d-i debconf/priority select critical
d-i auto-install/enable boolean true
ubiquity ubiquity/summary note
ubiquity ubiquity/reboot boolean false
ubiquity ubiquity/poweroff boolean false
d-i finish-install/reboot_in_progress note
d-i cdrom-detect/eject boolean false

# --- Zielauswahl ---------------------------------------------------------
# Hier steht ABSICHTLICH keine Zielplatte.
# Die Zielplatte wird erst nach der Bestaetigung im Assistenten gesetzt.
# Eine fest eingebaute Zielplatte waere gefaehrlich.
# Siehe maximus/wizard.sh, Schritt 'Preseed zur Laufzeit erzeugen'.

# --- Benutzerzugang ------------------------------------------------------
# Hier steht ABSICHTLICH kein Benutzer und kein Passwort.
# Der Assistent fragt beide einmal lokal ab.
# Ein fest eingebautes Standardpasswort waere gefaehrlich.

# --- Haken fuer den Assistenten ------------------------------------------
# Casper fuehrt dies im Initramfs aus. Das Live-System liegt dort auf /root.
# Der Haken kopiert den Assistenten in das Live-System und richtet den
# Autostart ein. Er installiert nichts und loescht nichts.
# Casper hat /cdrom bereits nach /root/cdrom verschoben (05mountpoints).
# Deshalb nennt der Haken beide Pfade.
d-i preseed/early_command string for p in /root/cdrom /cdrom /run/live/medium; do if [ -f "$p/maximus/early.sh" ]; then sh "$p/maximus/early.sh" "$p"; break; fi; done
