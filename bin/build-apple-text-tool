#!/usr/bin/env bash

set -euo pipefail

ROOT="/Users/maxim/Claude/apple-intelligence"
APP="$ROOT/build/TomAppleTextTool.app"
BIN="$APP/Contents/MacOS/TomAppleTextTool"
PLIST="$APP/Contents/Info.plist"

mkdir -p "$APP/Contents/MacOS"
cp "$ROOT/TomAppleTextTool-Info.plist" "$PLIST"

DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer \
swiftc \
  -module-cache-path /Users/maxim/Claude/.tmp-swift-module-cache \
  -framework AppKit \
  "$ROOT/TomAppleTextTool.swift" \
  -o "$BIN"

codesign --force --deep --sign - "$APP" >/dev/null 2>&1 || true
echo "$APP"
