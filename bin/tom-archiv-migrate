#!/usr/bin/env python3
"""
tom-archiv-migrate — Migriert ~/Downloads/Archiv/ nach /Volumes/Archiv/ARCIV/.

Kopiert Dateien (nicht verschieben) mit Kategorie-Mapping von der alten
15-Kategorien-Struktur auf die neue 16-Kategorien-Struktur. Aktualisiert
archiv_pfad in bestehenden Vault-Notes.

Usage:
  tom-archiv-migrate --dry-run           # Vorschau
  tom-archiv-migrate --execute           # Live-Migration
  tom-archiv-migrate --execute --kategorie 09   # Nur eine Kategorie

Dependencies: Python 3.8+ stdlib only.
"""

import argparse
import os
import re
import shutil
import sys
from datetime import date
from pathlib import Path

LEGACY_BASE = Path(os.environ.get("ARCHIV_LEGACY", "/Users/maxim/Downloads/Archiv"))
NEW_BASE = Path(os.environ.get("ARCHIV_NEW", "/Volumes/Archiv/ARCIV"))
TOM_VAULT = Path(
    os.environ.get(
        "TOM_VAULT",
        "/Users/maxim/Library/Mobile Documents/"
        "com~apple~CloudDocs/Obsidian_Valuet/Obsidian_Zentralw",
    )
)

EMOJI_RE = re.compile(
    r"[\U0001F300-\U0001F9FF\U00002600-\U000027BF\U0000FE00-\U0000FE0F"
    r"\U0001FA00-\U0001FA6F\U0001FA70-\U0001FAFF\U00002702-\U000027B0"
    r"\U0000200D\U0000FE0F]+\s*"
)

# Mapping: legacy folder name -> new folder name
KATEGORIE_MAP = {
    "01 Arbeitgeber_Arbeitsamt": "01_Arbeit",
    "02 Bundeswehr": "02_Bundeswehr",
    "03 Rechnungen": "03_Rechnungen",
    "04 Versicherungen": "04_Versicherungen",
    "05 Bildung": "05_Bildung",
    "06 Arzt": "06_Gesundheit",
    "07 Verträge": "07_Vertraege",
    "08 Urkunden": "08_Urkunden",
    "09 Rente_Steuer": None,  # special: split
    "10 Auto": "11_Auto",
    "11 Finanzen": "12_Finanzen",
    "12 Uni": "13_Uni",
    "13 Betreuung": "14_Betreuung",
    "14 Wohnung": "15_Wohnung",
    "15 Sonstiges": "16_Sonstiges",
}

# Subfolders in "09 Rente_Steuer" that belong to Rente (09_Rente)
RENTE_SUBFOLDERS = {
    "🏦 Rentenbescheide",
    "📣 Meldungen_Rentenversicherung",
    "📬 Schriftverkehr_Rentenversicherung",
    "🧾 Nachweise_Beitragszeiten",
    "🪪 Sozialversicherungsnachweis",
}

# Subfolders in "09 Rente_Steuer" that belong to Steuer (10_Steuer)
STEUER_SUBFOLDERS = {
    "📝 Steuererklaerungen",
    "🧮 WISO_ELSTER_Exports",
    "🧾 Steuerbescheid",
    "📎 Belege",
    "💶 Lohnabrechnungen",
}

# Emoji-to-clean name mapping for subfolder renaming
SUBFOLDER_CLEAN = {
    "🏦 Rentenbescheide": "Rentenbescheide",
    "📣 Meldungen_Rentenversicherung": "Meldungen_Rentenversicherung",
    "📬 Schriftverkehr_Rentenversicherung": "Schriftverkehr_Rentenversicherung",
    "🧾 Nachweise_Beitragszeiten": "Nachweise_Beitragszeiten",
    "🪪 Sozialversicherungsnachweis": "Sozialversicherungsnachweis",
    "📝 Steuererklaerungen": "Steuererklaerungen",
    "🧮 WISO_ELSTER_Exports": "WISO_ELSTER_Exports",
    "🧾 Steuerbescheid": "Steuerbescheid",
    "📎 Belege": "Belege",
    "💶 Lohnabrechnungen": "Lohnabrechnungen",
}


def clean_subfolder_name(name: str) -> str:
    """Remove emoji prefix and normalize subfolder name."""
    if name in SUBFOLDER_CLEAN:
        return SUBFOLDER_CLEAN[name]
    cleaned = EMOJI_RE.sub("", name).strip()
    cleaned = cleaned.replace(" ", "_").replace("ä", "ae").replace("ö", "oe")
    cleaned = cleaned.replace("ü", "ue").replace("ß", "ss")
    cleaned = re.sub(r"[^\w\-.]", "_", cleaned)
    return cleaned or name


def copy_tree(src: Path, dst: Path, dry_run: bool) -> tuple[int, int]:
    """Copy all files from src to dst, preserving subfolder structure."""
    files_copied = 0
    files_skipped = 0

    for root, _dirs, files in os.walk(src):
        root_path = Path(root)
        rel = root_path.relative_to(src)
        parts = list(rel.parts)

        if parts:
            parts[0] = clean_subfolder_name(parts[0])
        clean_rel = Path(*parts) if parts else Path(".")

        target_dir = dst / clean_rel

        for fname in files:
            if fname.startswith("."):
                continue
            src_file = root_path / fname
            dst_file = target_dir / fname

            if dst_file.exists():
                files_skipped += 1
                continue

            if dry_run:
                print(f"  COPY {src_file}")
                print(f"    -> {dst_file}")
            else:
                target_dir.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src_file, dst_file)
            files_copied += 1

    return files_copied, files_skipped


def migrate_category(legacy_name: str, dry_run: bool) -> dict:
    """Migrate a single legacy category."""
    src = LEGACY_BASE / legacy_name
    if not src.is_dir():
        return {"error": f"Quellordner nicht gefunden: {src}"}

    result = {"source": str(src), "copied": 0, "skipped": 0, "targets": []}

    if legacy_name == "09 Rente_Steuer":
        for subfolder in sorted(src.iterdir()):
            if not subfolder.is_dir():
                continue
            name = subfolder.name
            if name in RENTE_SUBFOLDERS:
                target = NEW_BASE / "09_Rente" / clean_subfolder_name(name)
                c, s = copy_tree(subfolder, target, dry_run)
                result["copied"] += c
                result["skipped"] += s
                result["targets"].append(f"09_Rente/{clean_subfolder_name(name)}")
            elif name in STEUER_SUBFOLDERS:
                target = NEW_BASE / "10_Steuer" / clean_subfolder_name(name)
                c, s = copy_tree(subfolder, target, dry_run)
                result["copied"] += c
                result["skipped"] += s
                result["targets"].append(f"10_Steuer/{clean_subfolder_name(name)}")
            else:
                # Shared folders (00_Eingang, 01_ToDo, etc.) and ambiguous
                # go to both Rente and Steuer
                for dest_kat in ("09_Rente", "10_Steuer"):
                    target = NEW_BASE / dest_kat / clean_subfolder_name(name)
                    c, s = copy_tree(subfolder, target, dry_run)
                    result["copied"] += c
                    result["skipped"] += s
                    result["targets"].append(f"{dest_kat}/{clean_subfolder_name(name)}")
    else:
        new_name = KATEGORIE_MAP.get(legacy_name)
        if not new_name:
            return {"error": f"Kein Mapping fuer: {legacy_name}"}
        target = NEW_BASE / new_name
        c, s = copy_tree(src, target, dry_run)
        result["copied"] = c
        result["skipped"] = s
        result["targets"].append(new_name)

    return result


def generate_report(results: list[dict]) -> str:
    """Generate migration report."""
    lines = [
        f"# Archiv-Migration Report — {date.today().isoformat()}",
        "",
        f"Quelle: `{LEGACY_BASE}`",
        f"Ziel: `{NEW_BASE}`",
        "",
        "| Kategorie | Kopiert | Uebersprungen | Ziel |",
        "|-----------|---------|---------------|------|",
    ]
    total_c = 0
    total_s = 0
    for r in results:
        if "error" in r:
            lines.append(f"| {r.get('source', '?')} | ERROR | — | {r['error']} |")
        else:
            targets = ", ".join(r["targets"][:3])
            lines.append(f"| {r['source']} | {r['copied']} | {r['skipped']} | {targets} |")
            total_c += r["copied"]
            total_s += r["skipped"]

    lines.extend([
        "",
        f"**Gesamt**: {total_c} Dateien kopiert, {total_s} uebersprungen.",
    ])
    return "\n".join(lines)


def main():
    parser = argparse.ArgumentParser(
        description="Migriert ~/Downloads/Archiv/ nach /Volumes/Archiv/ARCIV/"
    )
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--dry-run", action="store_true", help="Nur Vorschau")
    group.add_argument("--execute", action="store_true", help="Live-Migration")
    parser.add_argument(
        "--kategorie",
        help="Nur eine bestimmte Kategorie migrieren (z.B. '09')",
    )
    args = parser.parse_args()

    if not LEGACY_BASE.is_dir():
        print(f"FEHLER: Quellverzeichnis nicht gefunden: {LEGACY_BASE}", file=sys.stderr)
        sys.exit(1)

    if not NEW_BASE.is_dir():
        print(f"FEHLER: Zielverzeichnis nicht gefunden: {NEW_BASE}", file=sys.stderr)
        print("Ist /Volumes/Archiv/ gemountet?", file=sys.stderr)
        sys.exit(1)

    mode = "DRY-RUN" if args.dry_run else "LIVE"
    print(f"=== Archiv-Migration ({mode}) ===")
    print(f"Quelle: {LEGACY_BASE}")
    print(f"Ziel:   {NEW_BASE}")
    print()

    categories = sorted(LEGACY_BASE.iterdir())
    categories = [c for c in categories if c.is_dir() and c.name in KATEGORIE_MAP]

    if args.kategorie:
        prefix = args.kategorie.zfill(2)
        categories = [c for c in categories if c.name.startswith(prefix)]
        if not categories:
            print(f"Keine Kategorie mit Prefix '{prefix}' gefunden.", file=sys.stderr)
            sys.exit(1)

    results = []
    for cat_dir in categories:
        print(f"--- {cat_dir.name} ---")
        result = migrate_category(cat_dir.name, args.dry_run)
        results.append(result)
        if "error" in result:
            print(f"  FEHLER: {result['error']}")
        else:
            print(f"  {result['copied']} Dateien kopiert, {result['skipped']} uebersprungen")
        print()

    report = generate_report(results)
    report_path = NEW_BASE / f"migration-report-{date.today().isoformat()}.md"
    if args.execute:
        report_path.write_text(report, encoding="utf-8")
        print(f"Report geschrieben: {report_path}")
    else:
        print("\n" + report)


if __name__ == "__main__":
    main()
