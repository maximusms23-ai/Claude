#!/usr/bin/env bash
# tom-clip-enrich — Reichert Obsidian-Clippings mit Summary/Tags/Konzepten via qwen2.5:3b an
#
# Liest eine Clipping-Datei, ruft lokales qwen2.5:3b für Enrichment,
# schreibt strukturierte Felder ins Frontmatter zurück. Idempotent via
# `enriched: true`. Konzept-Vorschläge landen in
# $TOM_VAULT/90_Wiki/konzepte-vorschlaege.md zur manuellen Review.
#
# Usage:
#   tom-clip-enrich <pfad-zum-clipping>
#   tom-clip-enrich --dry-run <pfad>
#   tom-clip-enrich --force <pfad>             # re-enrich trotz enriched-Flag
#
# Beispiel:
#   tom-clip-enrich "$TOM_VAULT/Clippings/Mannheim – Wikipedia.md"

set -euo pipefail

TOOL_DIR="/Users/maxim/Claude/claude-memory-compiler"

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  cat <<EOF
tom-clip-enrich — Obsidian-Clipping Auto-Enrichment via qwen2.5:3b

Usage:
  tom-clip-enrich <pfad>
  tom-clip-enrich --dry-run <pfad>
  tom-clip-enrich --force <pfad>

Schreibt ins Frontmatter:
  summary                   3-5 Sätze Zusammenfassung (deutsch)
  tags                      existing + 3-5 qwen-Vorschläge (dedupliziert)
  suggested_wiki_category   themen / konzepte / personen / projekte / quellen
  enriched: true            Idempotenz-Flag
  enriched_at: YYYY-MM-DD   Datums-Stempel

Konzept-Vorschläge landen in:
  \$TOM_VAULT/90_Wiki/konzepte-vorschlaege.md

Braucht: laufenden "ollama serve" + verfuegbares qwen2.5:3b.
EOF
  exit 0
fi

export TOM_VAULT="${TOM_VAULT:-/Users/maxim/Library/Mobile Documents/com~apple~CloudDocs/Obsidian_Valuet/Obsidian_Zentralw}"
export OLLAMA_MODELS="${OLLAMA_MODELS:-/Users/maxim/Ollama}"

cd "$TOOL_DIR"
exec uv run python -m tom_tools.clip_enrich "$@"
