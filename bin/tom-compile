#!/usr/bin/env bash
# tom-compile — Kompiliere daily-Logs aus 95_Gehirn/daily/ zu knowledge/-Artikeln
#
# Zwei Modi:
#   tom-compile               # Default: claude_agent_sdk via Subscription (erprobt, shipped)
#   tom-compile --local       # Alternative: lokales gemme ohne Subscription (seit v1.4)
#
# Usage:
#   tom-compile                       # neue Logs via claude-sdk
#   tom-compile --all                 # re-kompiliert alles (claude-sdk)
#   tom-compile --local --file <log>  # lokal via gemme (einzelnes File)
#   tom-compile --local --file <log> --output-dir /tmp/sandbox  # Sandbox-Run
#
# Läuft typischerweise einmal täglich (z.B. 18:00). Nicht bei jedem SessionEnd.
#
# --local Trade-offs:
#   Pro: Kein Subscription-Verbrauch, vollständig lokal, deterministisch-reproduzierbar
#   Con: Kein Tool-Access → fragileres JSON-Parsing, 8192 num_ctx Budget
#   Eval: Gemma/eval/results/v1.4-compile-local-vs-claude.md
#
# Default bleibt claude_agent_sdk bis Eval etwas anderes belegt.

set -euo pipefail

TOOL_DIR="/Users/maxim/Claude/claude-memory-compiler"
export TOM_VAULT="${TOM_VAULT:-/Users/maxim/Library/Mobile Documents/com~apple~CloudDocs/Obsidian_Valuet/Obsidian_Zentralw}"
export OLLAMA_MODELS="${OLLAMA_MODELS:-/Users/maxim/Ollama}"

cd "$TOOL_DIR"

# Check for --local flag (must be first argument)
if [[ "${1:-}" == "--local" ]]; then
  shift
  exec uv run python -m tom_tools.compile_local "$@"
fi

exec uv run python scripts/compile.py "$@"
