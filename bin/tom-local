#!/usr/bin/env bash
# tom-local — Ausführung im lokalen OmniRoute/Sonnet-Modus ohne current shell zu berühren
#
# Usage:
#   tom-local             → spawnt interactive Subshell mit ANTHROPIC_*-env gesetzt
#   tom-local claude      → startet claude einmalig im lokalen Modus
#   tom-local <cmd> ...   → beliebiges Kommando im lokalen Modus ausführen
#
# Unterschied zu `nutze-ollama`:
#   - `nutze-ollama` modifiziert die AKTUELLE Shell (nur als sourced Funktion)
#   - `tom-local` spawnt eine NEUE Subshell — aktuelle Shell bleibt unberührt
#
# Bei `exit` (aus Subshell) oder Kommando-Ende ist der Lokal-Modus weg.

set -uo pipefail

NUTZE_OLLAMA_LIB="/Users/maxim/Claude/bin/nutze-ollama.sh"

if [ ! -f "$NUTZE_OLLAMA_LIB" ]; then
  echo "✗ Library nicht gefunden: $NUTZE_OLLAMA_LIB" >&2
  exit 1
fi

# Preflight via sourced Library-Funktion
# shellcheck disable=SC1090
source "$NUTZE_OLLAMA_LIB"

if ! _tom_ollama_preflight; then
  echo "✗ Preflight fehlgeschlagen" >&2
  exit 2
fi

_tom_apply_omniroute_env

if [ $# -eq 0 ]; then
  # Kein Argument → interactive Subshell spawnen
  cat >&2 <<EOF
⚠  Subshell im lokalen OmniRoute-Modus gestartet
   /model sonnet → ${ANTHROPIC_DEFAULT_SONNET_MODEL}
   /model opus   → ${ANTHROPIC_DEFAULT_OPUS_MODEL}
   /model haiku  → ${ANTHROPIC_DEFAULT_HAIKU_MODEL}
   Rückkehr zur Original-Shell: exit
EOF
  exec "${SHELL:-zsh}" -i
else
  # Argumente → einmaliges Kommando
  exec "$@"
fi
