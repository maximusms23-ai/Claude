        "kv_details": '""',
        "rente_relevant": "false",
        "rente_details": '""',
        "finanzen_relevant": "false",
        "finanzen_betrag": '""',
        "finanzen_faelligkeit": '""',
        "finanzen_budgetiert": "false",
        "finanzen_details": '""',
        "ki_zusammenfassung": '""',
