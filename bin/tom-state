def migrate_aufgaben(dry_run: bool = False):
    fields = f"""\
state: Offen
state_changed: {TODAY}
due_date: ""
priority: ""\
"""
    run_migration(
        Path(TOM_VAULT) / "40_Aufgaben",
        fields, "state", "migrate-aufgaben", dry_run,
    )


def migrate_termine(dry_run: bool = False):
    """Migrate notes in 50_Gesundheit/ and any termin-type notes."""
    fields = f"""\
state: Planung
state_changed: {TODAY}
termin_kategorie: ""
naechster_termin: ""
due_date: ""\
"""
    for folder in ["50_Gesundheit"]:
        target = Path(TOM_VAULT) / folder
        if target.is_dir():
            run_migration(target, fields, "state",
                          f"migrate-termine ({folder})", dry_run)


APP_LINK_MAP = {
    "arzt": ("Doctolib", "https://www.doctolib.de"),
    "auto": ("ADAC Services", "https://www.adac.de/services/"),
    "amt": ("Behoerdenfinder", "https://www.behoerdenfinder.de"),
    "steuer": ("Elster", "https://www.elster.de"),
}


def build_verpasst_block(fm: str, termin_date: str) -> str:
    telefon = get_field(fm, "telefon")
    ansprechperson = get_field(fm, "ansprechperson") or "Praxis/Stelle"
    kategorie = get_field(fm, "termin_kategorie")
    morgen = (date.today() + timedelta(days=1)).isoformat()

    tel_line = (
        f"- Anrufen: [tel:{telefon}](tel:{telefon}) ({ansprechperson})"
        if telefon
        else f"- Anrufen: _(Telefonnummer nicht hinterlegt — bitte im Frontmatter `telefon` ergaenzen)_"
    )

    app_name, app_url = APP_LINK_MAP.get(kategorie, ("", ""))
    app_line = (
        f"- Online buchen: [{app_name}]({app_url})"
        if app_name
        else "- Online buchen: _(keine App fuer diese Kategorie hinterlegt)_"
    )

    phone_plain = (
        f"- Telefonnummer: {telefon}"
        if telefon
        else ""
    )

    lines = [
        "<!-- verpasst-empfehlung -->",
        "## Handlungsempfehlung (Termin verpasst)",
        "",
        f"> Dieser Termin ({termin_date}) wurde verpasst. Bitte neuen Termin vereinbaren.",
        "",
        "**Neuen Termin buchen:**",
        tel_line,
        app_line,
    ]
    if phone_plain:
        lines.append(phone_plain)
    lines += [
        "",
        f"- [ ] Neuen Termin vereinbaren (@{morgen})",
    ]
    return "\n".join(lines)


def auto_transition(dry_run: bool = False):
    vault = Path(TOM_VAULT)
    today_date = date.today()
    today_str = today_date.isoformat()
    soon_14 = today_date + timedelta(days=14)

    scan_dirs_termine = ["50_Gesundheit", "30_Projekte", "00_Inbox"]
    scan_dirs_vertraege = ["60_Finanzen", "20_Dokumente"]

    transitions = 0
    skipped = 0
    errors = 0

    print(f"=== tom-state auto-transition {'(DRY-RUN)' if dry_run else '(LIVE)'} — {today_str} ===\n")

    # --- Termine ---
    for folder in scan_dirs_termine:
        target = vault / folder
        if not target.is_dir():
            continue
        for path in sorted(target.rglob("*.md")):
            if path.name in SKIP_FILES:
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except Exception as e:
                print(f"  FEHLER: {path.name} — {e}")
                errors += 1
                continue

            fm, body, has_fm = parse_frontmatter(text)
            if not has_fm:
                continue

            note_type = get_field(fm, "type")
            if note_type != "termin":
                continue

            current_state = get_field(fm, "state")
            datum_str = get_field(fm, "datum")
            if not datum_str:
                continue

            try:
                termin_date = date.fromisoformat(datum_str)
            except ValueError:
                continue

            new_state = None
            inject_verpasst = False

            if current_state in ("Planung", "Bestaetigt") and termin_date == today_date:
                new_state = "Heute"
            elif current_state == "Heute" and termin_date < today_date:
                new_state = "Verpasst"
                inject_verpasst = True
            elif current_state in ("Planung", "Bestaetigt") and termin_date < today_date:
                new_state = "Verpasst"
                inject_verpasst = True

            if not new_state:
                skipped += 1
                continue

            rel = path.relative_to(vault)
            if dry_run:
                print(f"  WUERDE: {rel} — {current_state} -> {new_state}")
                if inject_verpasst:
                    print(f"          + Handlungsempfehlung injizieren")
                transitions += 1
                continue

            new_fm = set_field(fm, "state", new_state)
            new_fm = set_field(new_fm, "state_changed", today_str)
            new_text = f"---\n{new_fm}\n---{body}"

            if inject_verpasst and "<!-- verpasst-empfehlung -->" not in body:
                verpasst_block = build_verpasst_block(fm, datum_str)
                insert_marker = "## Ergebnis / Nachbereitung"
                if insert_marker in new_text:
                    new_text = new_text.replace(
                        insert_marker,
                        verpasst_block + "\n\n" + insert_marker,
                    )
                else:
                    new_text = new_text.rstrip() + "\n\n" + verpasst_block + "\n"

            try:
                path.write_text(new_text, encoding="utf-8")
                print(f"  TRANSITION: {rel} — {current_state} -> {new_state}")
                if inject_verpasst:
                    print(f"              + Handlungsempfehlung injiziert")
                transitions += 1
            except Exception as e:
                print(f"  FEHLER: {path.name} — {e}")
                errors += 1

    # --- Vertraege ---
    for folder in scan_dirs_vertraege:
        target = vault / folder
        if not target.is_dir():
            continue
        for path in sorted(target.rglob("*.md")):
            if path.name in SKIP_FILES:
                continue
            try:
                text = path.read_text(encoding="utf-8")
            except Exception as e:
                print(f"  FEHLER: {path.name} — {e}")
                errors += 1
                continue

            fm, body, has_fm = parse_frontmatter(text)
            if not has_fm:
                continue

            note_type = get_field(fm, "type")
            if note_type != "vertrag":
                continue

            current_state = get_field(fm, "state")
            frist_str = get_field(fm, "kuendigungsfrist_datum")
            if not frist_str:
                continue

            try:
                frist_date = date.fromisoformat(frist_str)
            except ValueError:
                continue

            new_state = None

            if current_state == "aktiv" and frist_date <= soon_14:
                new_state = "Frist-naht"
            elif current_state == "Frist-naht" and frist_date < today_date:
                new_state = "Versaeumt"

            if not new_state:
                skipped += 1
                continue

            rel = path.relative_to(vault)
            if dry_run:
                print(f"  WUERDE: {rel} — {current_state} -> {new_state}")
                transitions += 1
                continue

            new_fm = set_field(fm, "state", new_state)
            new_fm = set_field(new_fm, "state_changed", today_str)
            new_text = f"---\n{new_fm}\n---{body}"

            try:
                path.write_text(new_text, encoding="utf-8")
                print(f"  TRANSITION: {rel} — {current_state} -> {new_state}")
                transitions += 1
            except Exception as e:
                print(f"  FEHLER: {path.name} — {e}")
                errors += 1

    print(f"\n--- Ergebnis ---")
    print(f"  Transitionen: {transitions}")
    print(f"  Uebersprungen: {skipped}")
    if errors:
        print(f"  Fehler: {errors}")


def main():
    parser = argparse.ArgumentParser(
        description="Tom Lifecycle-State-Migration"
    )
    sub = parser.add_subparsers(dest="command")

    for cmd in ["migrate-dokumente", "migrate-dokumente-v2",
                "migrate-dokumente-v3",
                "migrate-aufgaben", "migrate-termine",
                "auto-transition"]:
        p = sub.add_parser(cmd)
        p.add_argument("--dry-run", action="store_true",
                       help="Nur anzeigen, nichts schreiben")

    args = parser.parse_args()

    dispatch = {
        "migrate-dokumente": lambda: migrate_dokumente(args.dry_run),
        "migrate-dokumente-v2": lambda: migrate_dokumente_v2(args.dry_run),
        "migrate-dokumente-v3": lambda: migrate_dokumente_v3(args.dry_run),
        "migrate-aufgaben": lambda: migrate_aufgaben(args.dry_run),
        "migrate-termine": lambda: migrate_termine(args.dry_run),
        "auto-transition": lambda: auto_transition(args.dry_run),
    }

    if args.command in dispatch:
        dispatch[args.command]()
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
